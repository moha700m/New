# كلمة مرور لوحة الإدارة (12 حرفاً على الأقل)
ADMIN_PASSWORD=change-me-to-a-long-password

# مفتاح توقيع الجلسات: نص عشوائي طويل (32 حرفاً على الأقل)
# مثال للتوليد: openssl rand -base64 48
SESSION_SECRET=

# يُضاف تلقائياً عند ربط Vercel Blob بالمشروع
BLOB_READ_WRITE_TOKEN=

# اختياري: العملة الافتراضية للعملاء الجدد والمنطقة الزمنية لعرض التواريخ
DEFAULT_CURRENCY=USD
APP_TIMEZONE=Asia/Riyadh

<Window x:Class="MohammedLab.ColorVision.TrainingLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Training Lab — Mohammed Lab PC"
        Width="560" Height="690" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Color Training Lab" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Visual / Offline Training" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="Tunes what the preview and HUD consider a player-shaped color marker. It does not move aim, fire, or create a virtual controller."
                       Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick Profiles" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Start with a profile, then fine-tune below." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,8"/>
                        <UniformGrid Columns="3">
                            <Button Content="Close" Click="PresetClose_Click"/>
                            <Button Content="Balanced" Click="PresetBalanced_Click"/>
                            <Button Content="Wide" Click="PresetWide_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Target Color" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Marker preset" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="CmbMarker" SelectionChanged="ControlChanged"/>
                        <TextBlock Text="Default BO7-style outline preset is Purple. Choose another only for offline/custom visual tests."
                                   Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Visual FOV Radius" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtFov" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SldFov" Minimum="40" Maximum="400" TickFrequency="10" ValueChanged="ControlChanged" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ChkShowFov" Content="Show FOV circle in preview" Click="ControlChanged" Margin="0,8,0,0"/>
                        <TextBlock Text="Only candidates inside this circle are considered by the visual detector."
                                   Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum Confidence" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtConfidence" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SldConfidence" Minimum="20" Maximum="95" TickFrequency="1" ValueChanged="ControlChanged" Margin="0,8,0,0"/>
                        <TextBlock Text="Raise this if UI elements or effects are still being marked. Lower it only if valid player outlines are missed."
                                   Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Stability Frames" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtStability" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SldStability" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ControlChanged" Margin="0,8,0,0"/>
                        <TextBlock Text="Requires the same player-shaped candidate across multiple frames before it is confirmed."
                                   Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Preview Smoothing" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtSmoothing" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SldSmoothing" Minimum="0" Maximum="90" TickFrequency="5" ValueChanged="ControlChanged" Margin="0,8,0,0"/>
                        <TextBlock Text="Smooths only the marker drawn in the preview. Detection remains independent and no input is generated."
                                   Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Raised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Current visual profile" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                        <TextBlock x:Name="TxtSummary" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Reset defaults" Click="Reset_Click" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Content="Close" Click="Close_Click"/>
            <Button Grid.Column="2" Content="Save &amp; Close" Style="{StaticResource PrimaryButton}" Click="SaveClose_Click" Padding="18,9"/>
        </Grid>
    </Grid>
</Window>

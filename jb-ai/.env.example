# PostgreSQL connection string
DATABASE_URL="postgresql://user:pass@localhost:5432/jbai?schema=public"
# Public URL of the site (used in emails, Stripe redirects)
APP_URL="http://localhost:3000"
# 32 random bytes, base64 or hex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=""
# This email becomes OWNER (full admin) when it registers or logs in
OWNER_EMAIL=""
# Optional: email delivery for verification + password reset
SMTP_URL=""
MAIL_FROM="JB AI <no-reply@example.com>"
# Optional: Stripe (can instead be set, encrypted, in Admin → Payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: bootstrap Venice key at seed time (normally set in Admin → AI Providers)
VENICE_API_KEY=""

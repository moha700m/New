<Window x:Class="MohammedLab.ColorVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mohammed Lab PC" Width="1080" Height="720" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="MOHAMMED LAB" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="PC" FontWeight="Bold" FontSize="27" Margin="0,2,0,0"/>
                    <TextBlock Text="PC Color Detection" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <Button x:Name="NavCapture" Content="Capture" HorizontalContentAlignment="Left" Click="NavCapture_Click"/>
                    <Button x:Name="NavGame" Content="Game Control" HorizontalContentAlignment="Left" Click="NavGame_Click"/>
                    <Button x:Name="NavGuide" Content="Guide" HorizontalContentAlignment="Left" Click="NavGuide_Click"/>
                    <Button x:Name="NavCheck" Content="Check" HorizontalContentAlignment="Left" Click="NavCheck_Click"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Mohammed Lab" FontWeight="SemiBold"/>
                        <TextBlock Text="Ready" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="StatusDevice" Text="Device: Mouse" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid x:Name="CapturePage">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Capture" FontSize="26" FontWeight="Bold"/><TextBlock Text="Screen capture settings" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    <Button x:Name="BtnToggle" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Start" Click="BtnToggle_Click" Padding="22,10"/>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Monitor" FontWeight="SemiBold"/><ComboBox x:Name="CmbMonitor" SelectionChanged="SettingChanged"/>
                                <TextBlock Text="Capture FPS" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="CmbFps" SelectionChanged="SettingChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Zone Width" FontWeight="SemiBold"/><ComboBox x:Name="CmbWidth" SelectionChanged="SettingChanged"/>
                                <TextBlock Text="Zone Height" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="CmbHeight" SelectionChanged="SettingChanged"/>
                            </StackPanel>
                        </Grid></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <CheckBox x:Name="ChkNoPreview" Content="No Preview" Click="SettingChanged"/>
                            <CheckBox x:Name="ChkHud" Content="Show HUD" Click="SettingChanged"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Capture Status" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock x:Name="TxtFps" Text="Capture: stopped" Margin="0,10,0,0"/>
                            <TextBlock x:Name="TxtDet" Text="Detection: idle" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtFrames" Text="Target: none" Margin="0,4,0,0"/>
                            <TextBlock Text="Marker color: #FF00FA" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="GamePage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Game Control" FontSize="26" FontWeight="Bold"/><TextBlock Text="Aim and controller settings" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Game" FontWeight="SemiBold"/><ComboBox x:Name="CmbGame" SelectionChanged="SettingChanged"><ComboBoxItem Content="BO7"/><ComboBoxItem Content="BO6"/><ComboBoxItem Content="MW"/><ComboBoxItem Content="MW4"/><ComboBoxItem Content="Overwatch"/></ComboBox>
                        <TextBlock Text="Device" FontWeight="SemiBold" Margin="0,10,0,0"/><ComboBox x:Name="CmbDevice" SelectionChanged="SettingChanged"><ComboBoxItem Content="Mouse"/><ComboBoxItem Content="Controller"/></ComboBox>
                        <TextBlock x:Name="TxtDeviceNote" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0"><TextBlock Text="Aim Button" FontWeight="SemiBold"/><ComboBox x:Name="CmbAimButton" SelectionChanged="SettingChanged"/><TextBlock Text="Aim Mouse Key" FontWeight="SemiBold" Margin="0,10,0,0"/><ComboBox x:Name="CmbAimKey" SelectionChanged="SettingChanged"><ComboBoxItem Content="Right Mouse" Tag="2"/><ComboBoxItem Content="Middle Mouse" Tag="4"/><ComboBoxItem Content="Mouse 4" Tag="5"/><ComboBoxItem Content="Mouse 5" Tag="6"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Fire Button" FontWeight="SemiBold"/><ComboBox x:Name="CmbFireButton" SelectionChanged="SettingChanged"/><Button Content="Replug Controller" Click="BtnReplug_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <CheckBox x:Name="ChkHold" Content="Hold To Aim" Click="SettingChanged"/>
                        <CheckBox x:Name="ChkAlways" Content="Always Track" Click="SettingChanged"/>
                        <TextBlock Text="Strength" FontWeight="SemiBold" Margin="0,8,0,0"/><Slider x:Name="SldStrength" Minimum="1" Maximum="10" ValueChanged="SettingChanged"/><TextBlock x:Name="TxtStrength" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Aim Point Offset" FontWeight="SemiBold" Margin="0,8,0,0"/><Slider x:Name="SldOffset" Minimum="-100" Maximum="100" ValueChanged="SettingChanged"/><TextBlock x:Name="TxtOffset" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <CheckBox x:Name="ChkRecoil" Content="Anti-Recoil" Click="SettingChanged"/>
                        <StackPanel x:Name="RecoilRow"><TextBlock Text="Anti-Recoil Strength" FontWeight="SemiBold"/><Slider x:Name="SldRecoil" Minimum="0" Maximum="20" ValueChanged="SettingChanged"/><TextBlock x:Name="TxtRecoil" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <CheckBox x:Name="ChkAutoFire" Content="Auto Fire" Click="SettingChanged"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Controller Test" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TxtPad" Text="No controller data." FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>

            <Grid x:Name="GuidePage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Guide" FontSize="26" FontWeight="Bold"/><TextBlock Text="Game marker setup" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
                    <TabControl x:Name="GuideTabs" SelectionChanged="GuideTabs_SelectionChanged">
                        <TabItem Header="BO7"><TextBlock Margin="14" Text="Open Interface → Readability → Color Customization. Set the Enemy marker color to #FF00FA, then keep the in-game enemy marker visible." TextWrapping="Wrap"/></TabItem>
                        <TabItem Header="BO6"><TextBlock Margin="14" Text="Open Interface → Readability → Color Customization. Set the Enemy marker color to #FF00FA and keep Player Names / enemy indicators enabled." TextWrapping="Wrap"/></TabItem>
                        <TabItem Header="MW"><TextBlock Margin="14" Text="Open Interface → Color Customization. Set Enemy to #FF00FA and keep enemy HUD markers enabled." TextWrapping="Wrap"/></TabItem>
                        <TabItem Header="MW4"><TextBlock Margin="14" Text="Open Interface → Readability / HUD Colors. Set Enemy to #FF00FA and keep HUD bounds / markers enabled." TextWrapping="Wrap"/></TabItem>
                    </TabControl>
                    <TextBlock x:Name="TxtNote" Text="The detector uses the same fixed marker range as the reference application." Foreground="{StaticResource MutedBrush}" Margin="8,14,8,0" TextWrapping="Wrap"/>
                </StackPanel></Border>
            </Grid>

            <Grid x:Name="CheckPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Check" FontSize="26" FontWeight="Bold"/><TextBlock Text="System and controller checks" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,18,0,0"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="System" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TxtCheckOs" Margin="0,10,0,0"/><TextBlock x:Name="TxtCheckRuntime" Margin="0,4,0,0"/><TextBlock x:Name="TxtCheckAdmin" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Controller" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TxtCheckPad" Margin="0,10,0,0"/><TextBlock x:Name="TxtCheckVigem" Margin="0,4,0,0"/><Button Content="Run Check" Click="BtnCheck_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Detection" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Expected marker: #FF00FA • HSV H 140–158, S ≥ 90, V ≥ 110" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="MohammedLab.ColorVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mohammed Lab PC" Width="1320" Height="840" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Window}">
    <Window.Resources>
        <DropShadowEffect x:Key="ToastShadow" Color="Black" Opacity="0.4" BlurRadius="14" ShadowDepth="3" RenderingBias="Quality"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- ======================= Header ======================= -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.Header}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Brush.Accent}" Margin="0,0,12,0">
                            <TextBlock Text="ML" Foreground="{StaticResource Brush.OnAccent}" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mohammed Lab PC" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HeaderPageTitle" Text="Capture" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusChip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderControllerDot" Width="8" Height="8" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeaderControllerText" Text="Controller • Not connected" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusChip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderCaptureDot" Width="8" Height="8" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeaderCaptureText" Text="Capture • Stopped" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Sidebar ======================= -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" Margin="12,6,0,10"/>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavCapture" Style="{StaticResource NavButton}" Click="NavCapture_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1,3 L1,13 L15,13 L15,3 Z M3,1 L13,1 L15,3 M5,13 L5,15 L11,15 L11,13" Stretch="Uniform"
                                      Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="1,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Capture" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGame" Style="{StaticResource NavButton}" Click="NavGame_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1.5,3.5 C1.5,2.7 2.2,2 3,2 L13,2 C13.8,2 14.5,2.7 14.5,3.5 L15.2,11 C15.2,12.1 14.2,13 13.2,13 C12.6,13 12,12.7 11.6,12.2 L10.5,10.8 L5.5,10.8 L4.4,12.2 C4,12.7 3.4,13 2.8,13 C1.8,13 0.8,12.1 0.8,11 Z M4.2,4.6 L4.2,7.6 M2.7,6.1 L5.7,6.1 M11,5.3 L11.4,5.3 M12.6,6.9 L13,6.9" Stretch="Uniform"
                                      Width="17" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeLineCap="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Control" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGuide" Style="{StaticResource NavButton}" Click="NavGuide_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,2.5 C6.3,1.5 4,1.3 2,1.8 L2,11.5 C4,11 6.3,11.2 8,12.2 C9.7,11.2 12,11 14,11.5 L14,1.8 C12,1.3 9.7,1.5 8,2.5 Z M8,2.5 L8,12.2" Stretch="Uniform"
                                      Width="16" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Margin="1,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guide" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCheck" Style="{StaticResource NavButton}" Click="NavCheck_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,1 L14,3.2 L14,7.5 C14,11 11.5,13.7 8,14.7 C4.5,13.7 2,11 2,7.5 L2,3.2 Z M5.4,7.4 L7.2,9.2 L10.8,5.4" Stretch="Uniform"
                                      Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Margin="1,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Check" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Corner.Medium}" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDevice" Text="Device: Mouse" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="v1.5.11  •  x64 self-contained" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="20,18,20,8">

                <!-- ============ Capture page ============ -->
                <Grid x:Name="CapturePage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- Capture status header card -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse x:Name="CaptureStateDot" Width="10" Height="10" Fill="{StaticResource Brush.Text.Muted}"/>
                                    </Border>
                                    <TextBlock x:Name="TxtCaptureState" Text="CAPTURE STOPPED" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCaptureSummary" Text="Monitor 1 • 400x560 • 90 FPS" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,6,0,0"/>
                                <TextBlock Text="Marker color: #FF00FA" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggle" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="START CAPTURE"
                                    Click="BtnToggle_Click" Padding="26,10" MinWidth="168" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Background="#2B1C21" BorderBrush="{StaticResource Brush.Error}"
                            BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="{StaticResource Brush.Error}" Margin="0,1,8,0" FontSize="10"/>
                                <TextBlock x:Name="ErrorText" Text="Capture error" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Retry" Click="BtnRetry_Click" Margin="12,0,0,0" Padding="12,5" MinHeight="30"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Capture Region" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                                        <ComboBox x:Name="CmbMonitor" SelectionChanged="SettingChanged"/>
                                        <TextBlock Text="Target FPS" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="CmbFps" SelectionChanged="SettingChanged"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbWidth" SelectionChanged="SettingChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbHeight" SelectionChanged="SettingChanged"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="ChkHud" Content="Show HUD" Click="SettingChanged" Margin="0,10,0,4"
                                                  ToolTip="Draws a transparent overlay with the capture frame, center cross and detected target."/>
                                        <CheckBox x:Name="ChkNoPreview" Content="No Preview" Click="SettingChanged" Margin="0,4,0,0"
                                                  ToolTip="Skips rendering the live preview to save GPU/CPU while capture keeps running."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="360"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="LIVE CAPTURE" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="The exact region used by color detection" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusChip}" Padding="9,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="PreviewLiveDot" Width="7" Height="7" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TxtPreviewLive" Text="OFFLINE" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{StaticResource Brush.PreviewBg}" BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                            <Canvas x:Name="PreviewOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                                                <Rectangle x:Name="PreviewTargetBox" Stroke="{StaticResource Brush.Success}" StrokeThickness="1.5" Visibility="Collapsed"/>
                                                <Ellipse x:Name="PreviewTargetDot" Fill="{StaticResource Brush.Success}" Width="6" Height="6" Visibility="Collapsed"/>
                                                <Line x:Name="PreviewCenterH" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1" Opacity="0.8" X1="-7" X2="7" Y1="0" Y2="0"/>
                                                <Line x:Name="PreviewCenterV" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1" Opacity="0.8" X1="0" X2="0" Y1="-7" Y2="7"/>
                                            </Canvas>
                                            <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M1,3 L1,13 L15,13 L15,3 Z M3,1 L13,1 L15,3 M5,13 L5,15 L11,15 L11,13" Stretch="Uniform"
                                                      Width="34" Height="34" Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.2" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No live capture" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                                <TextBlock x:Name="TxtPreviewHint" Text="Start capture to preview the selected region." Foreground="{StaticResource Brush.Text.Secondary}"
                                                           HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="Actual FPS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatActualFps" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="Target Status" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatTarget" Text="NO TARGET" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="StatLastFrame" Text="Last frame: —" Foreground="{StaticResource Brush.Text.Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="Frames" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatFrames" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Target FPS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatTargetFps" Text="90" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Grab" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatGrab" Text="0.00 ms" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Processing" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatProcessing" Text="0.00 ms" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Dropped" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatDropped" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RaisedCardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Candidates" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="StatCandidates" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ Game Control page ============ -->
                <Grid x:Name="GamePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Game Control" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Aim and controller settings" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GameBo7" Content="BO7" Tag="0" Style="{StaticResource SegmentButton}" Click="GameTab_Click"/>
                            <Button x:Name="GameBo6" Content="BO6" Tag="1" Style="{StaticResource SegmentButton}" Click="GameTab_Click"/>
                            <Button x:Name="GameMw" Content="MW" Tag="2" Style="{StaticResource SegmentButton}" Click="GameTab_Click"/>
                            <Button x:Name="GameMw4" Content="MW4" Tag="3" Style="{StaticResource SegmentButton}" Click="GameTab_Click"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Controller" Style="{StaticResource SectionTitle}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Ellipse x:Name="ControllerCardDot" Width="8" Height="8" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtControllerConnection" Text="NOT CONNECTED" FontWeight="SemiBold" Foreground="{StaticResource Brush.Error}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Ellipse x:Name="VirtualControllerDot" Width="8" Height="8" Fill="{StaticResource Brush.Text.Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtVirtualController" Text="Virtual controller: —" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="Rescan" Click="BtnRescanController_Click" Padding="12,6"/>
                                                <Button Content="Replug / Reconnect" Click="BtnReplug_Click" Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Device" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DeviceMouse" Content="Mouse" Tag="0" Style="{StaticResource SegmentButton}" Click="DeviceSegment_Click"/>
                                                <Button x:Name="DeviceController" Content="Controller" Tag="1" Style="{StaticResource SegmentButton}" Click="DeviceSegment_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtDeviceNote" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aim Controls" Style="{StaticResource SectionTitle}"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Aim Button" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbAimButton" SelectionChanged="SettingChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Fire Button" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbFireButton" SelectionChanged="SettingChanged"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Aim Key" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="CmbAimKey" SelectionChanged="SettingChanged">
                                            <ComboBoxItem Content="Right Mouse" Tag="2"/>
                                            <ComboBoxItem Content="Middle Mouse" Tag="4"/>
                                            <ComboBoxItem Content="Mouse 4" Tag="5"/>
                                            <ComboBoxItem Content="Mouse 5" Tag="6"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ChkHold" Content="Hold To Aim" Click="SettingChanged" Margin="0,10,0,4"
                                                  ToolTip="Aim only while the aim button or key is held down."/>
                                        <CheckBox x:Name="ChkAlways" Content="Always Track" Click="SettingChanged" Margin="0,4,0,0"
                                                  ToolTip="Keeps tracking and moving toward the target even without holding the aim button."/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Strength" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtStrength" Grid.Column="1" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="SldStrength" Minimum="1" Maximum="10" ValueChanged="SettingChanged"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Aim Point Offset" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                                       ToolTip="Shifts the aim point vertically, in pixels, relative to the detected target."/>
                                            <TextBlock x:Name="TxtOffset" Grid.Column="1" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="SldOffset" Minimum="-100" Maximum="100" ValueChanged="SettingChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Fire &amp; Recoil" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox x:Name="ChkRecoil" Content="Anti-Recoil" Click="SettingChanged" Margin="0,10,0,0"/>
                                        <StackPanel x:Name="RecoilRow">
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Anti-Recoil Strength" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtRecoil" Grid.Column="1" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldRecoil" Minimum="0" Maximum="20" ValueChanged="SettingChanged"/>
                                        </StackPanel>
                                        <Border Background="{StaticResource Brush.Border}" Height="1" Margin="0,12" Opacity="0.6"/>
                                        <CheckBox x:Name="ChkAutoFire" Content="Auto Fire" Click="SettingChanged" Margin="0,0,0,0"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Trigger Threshold" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTriggerThreshold" Grid.Column="1" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                        </Grid>
                                        <Slider x:Name="SldTriggerThreshold" Minimum="1" Maximum="255" ValueChanged="SettingChanged"/>
                                        <CheckBox x:Name="ChkSwapTriggers" Content="Swap Triggers" Click="SettingChanged" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Controller Tester" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Buttons light up when pressed on the physical controller." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,12"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Border x:Name="PadL1" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="L1" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadL2" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="L2" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadR1" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="R1" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadR2" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="R2" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadTriangle" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Triangle" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadCircle" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Circle" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadCross" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Cross" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadSquare" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Square" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadL3" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="L3" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadR3" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="R3" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadCreate" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Create" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadOptions" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="Options" HorizontalAlignment="Center"/></Border>
                                        </UniformGrid>
                                        <UniformGrid Columns="4" Margin="0,0,0,12">
                                            <Border x:Name="PadUp" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="D-Up" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadDown" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="D-Down" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadLeft" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="D-Left" HorizontalAlignment="Center"/></Border>
                                            <Border x:Name="PadRight" Style="{StaticResource RaisedCardStyle}" Margin="2" Padding="8"><TextBlock Text="D-Right" HorizontalAlignment="Center"/></Border>
                                        </UniformGrid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,0,8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Left Stick" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock x:Name="TxtLeftStick" Text="X 0  /  Y 0" FontFamily="Consolas" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource RaisedCardStyle}" Margin="0,0,0,8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Right Stick" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock x:Name="TxtRightStick" Text="X 0  /  Y 0" FontFamily="Consolas" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RaisedCardStyle}" Margin="0" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="L2 Trigger" Style="{StaticResource StatLabel}"/>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                        <Border Height="6" CornerRadius="3" Background="#3A404D" VerticalAlignment="Center">
                                                            <Border x:Name="L2Bar" Height="6" CornerRadius="3" Background="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Width="0"/>
                                                        </Border>
                                                        <TextBlock x:Name="TxtL2" Grid.Column="1" Text="0%" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource RaisedCardStyle}" Margin="0" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="R2 Trigger" Style="{StaticResource StatLabel}"/>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                        <Border Height="6" CornerRadius="3" Background="#3A404D" VerticalAlignment="Center">
                                                            <Border x:Name="R2Bar" Height="6" CornerRadius="3" Background="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Width="0"/>
                                                        </Border>
                                                        <TextBlock x:Name="TxtR2" Grid.Column="1" Text="0%" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ============ Guide page ============ -->
                <Grid x:Name="GuidePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Guide" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Quick setup by game" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Select Game" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TabControl x:Name="GuideTabs" SelectionChanged="GuideTabs_SelectionChanged">
                                <TabItem Header="BO7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush.Accent.Subtle}" Margin="0,0,10,0">
                                                        <TextBlock Text="1" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Set the in-game marker color" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Enable the enemy/highlight color expected by your profile." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="36,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush.Accent.Subtle}" Margin="0,0,10,0">
                                                        <TextBlock Text="2" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Center the capture region" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Keep the selected capture region centered on the crosshair." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="36,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush.Accent.Subtle}" Margin="0,0,10,0">
                                                        <TextBlock Text="3" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Start Capture" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Start Capture and confirm frames/FPS are moving in the statistics cards." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="36,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush.Accent.Subtle}" Margin="0,0,10,0">
                                                        <TextBlock Text="4" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Confirm the target" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Check Target Status shows TARGET DETECTED before enabling aim output." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="36,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="BO6">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BO6" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Use the same capture flow: set the in-game marker/highlight, center the capture region, start capture, then confirm LIVE and Target Status." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,10,0,0" LineHeight="22"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="MW">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="MW" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Select the matching in-game color settings, verify the capture preview, and use Check if controller or drivers are not detected." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,10,0,0" LineHeight="22"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="MW4">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="MW4" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Keep the capture area centered and confirm Actual FPS is close to Target FPS before adjusting Strength or Offset." TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,10,0,0" LineHeight="22"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ Check page ============ -->
                <Grid x:Name="CheckPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Check" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="System, capture and controller diagnostics" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Rescan" Click="BtnCheck_Click" VerticalAlignment="Center" Padding="18,8"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="System" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkOsDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Windows" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckOs" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckOsState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkRuntimeDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text=".NET Runtime" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckRuntime" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckRuntimeState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkOpenCvDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="OpenCV" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckOpenCv" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckOpenCvState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Capture" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkMonitorsDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Monitors" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckMonitors" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckMonitorsState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkCaptureDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Display Capture" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckCapture" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckCaptureState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Controller &amp; Drivers" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkPadDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Controller" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtCheckPad" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckPadState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkVigemDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ViGEm" FontWeight="SemiBold" ToolTip="Virtual controller driver used to emulate an Xbox controller."/>
                                            <TextBlock x:Name="TxtCheckVigem" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckVigemState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Grid.Column="3" x:Name="BtnInstallVigem" Content="Install" Click="BtnInstallVigem_Click" Padding="12,5" MinHeight="30" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ChkHidHideDot" Width="9" Height="9" Fill="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="HidHide" FontWeight="SemiBold" ToolTip="Hides the physical controller so games only see the virtual one."/>
                                            <TextBlock x:Name="TxtCheckHidHide" Text="—" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCheckHidHideState" Text="—" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Grid.Column="3" x:Name="BtnInstallHidHide" Content="Install" Click="BtnInstallHidHide_Click" Padding="12,5" MinHeight="30" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Detection" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Expected marker: #FF00FA • HSV H 140–158, S ≥ 90, V ≥ 110" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Version 1.5.11 • Windows x64 • Self-contained build" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================= Toast notifications ======================= -->
        <Border x:Name="ToastCard" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
                Background="{StaticResource Brush.Raised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="10" Padding="14,9" Effect="{StaticResource ToastShadow}" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource Brush.Success}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="Saved" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="8"/>
            </Border.RenderTransform>
        </Border>
    </Grid>
</Window>
